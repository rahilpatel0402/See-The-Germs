# Copy to server/.env (or repo root .env) and fill in. Never commit real keys.

# Meta Model API: SAM 3.1 video segmentation and Muse Spark 1.1 (text and vision)
MODEL_API_KEY=

# fal.ai: fallback SAM 3.1 video backend, only if the Meta endpoint fails the feasibility gate
FAL_KEY=

# Baseten: Muse Spark Open backend (meta-models/muse-spark-open-1026), after Gate 7 only
BASETEN_API_KEY=

# Which Spark backend serves narrative and adjudication: meta (default) or baseten
SPARK_BACKEND=meta

# Server port (default 8787) and the browser origin allowed to call it (default *)
PORT=8787
CLIENT_ORIGIN=*

# Precomputed demo clip ids served from cache, comma separated, for example A,B,C
DEMO_CLIPS=

# Credit protection for the live upload path (default 20 per day; each upload is 45 s max)
MAX_UPLOADS_PER_DAY=20

# Optional: folder holding ffmpeg and ffprobe when they are not on PATH
FFMPEG_DIR=
