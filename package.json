{
  "name": "see-the-germs",
  "private": true,
  "version": "0.1.0",
  "description": "Contamination chains made visible on staged video of care tasks. Staff training and audit aid, not surveillance, not medical advice.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "test": "node --test \"engine/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite client",
    "build:client": "vite build client",
    "analyze": "tsx server/scripts/analyze.ts",
    "accuracy": "tsx server/scripts/accuracy.ts",
    "adjudicate": "tsx server/scripts/adjudicate.ts",
    "narrate": "tsx server/scripts/narrate.ts",
    "build": "vite build client",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "openai": "^7.44.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
